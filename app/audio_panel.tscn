[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://app/AudioPanel.cs" id="1"]

[node name="AudioPanel" type="VBoxContainer"]
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Header" type="Button" parent="."]
layout_mode = 2
text = "▾ 音频"
toggle_mode = true
button_pressed = true
alignment = 0
theme_type_variation = &"SectionHeader"
custom_minimum_size = Vector2(0, 34)
flat = false

[node name="Fields" type="VBoxContainer" parent="."]
visible = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="File" type="Label" parent="Fields"]
layout_mode = 2
text = "未选择音频"
text_overrun_behavior = 3

[node name="Actions" type="HBoxContainer" parent="Fields"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Load" type="Button" parent="Fields/Actions"]
layout_mode = 2
text = "选择音频…"
theme_type_variation = &"QuietButton"
size_flags_horizontal = 0

[node name="Clear" type="Button" parent="Fields/Actions"]
layout_mode = 2
text = "移除音频"
theme_type_variation = &"QuietButton"
size_flags_horizontal = 0

[node name="Enabled" type="CheckButton" parent="Fields"]
layout_mode = 2
text = "预览播放并导出音频"
button_pressed = true
custom_minimum_size = Vector2(0, 32)

[node name="Offset" type="HBoxContainer" parent="Fields"]
layout_mode = 2

[node name="Label" type="Label" parent="Fields/Offset"]
layout_mode = 2
size_flags_horizontal = 3
text = "偏移（秒）"

[node name="Value" type="SpinBox" parent="Fields/Offset"]
layout_mode = 2
custom_minimum_size = Vector2(86, 32)
min_value = -3600.0
max_value = 3600.0
step = 0.001
alignment = 2
select_all_on_focus = true

[node name="Help" type="Label" parent="Fields"]
layout_mode = 2
autowrap_mode = 3
text = "正值延后；负值跳过音频开头。"
theme_type_variation = &"HelpLabel"

[node name="Files" type="FileDialog" parent="."]
title = "选择外部音频"
size = Vector2i(800, 500)
file_mode = 0
access = 2
filters = PackedStringArray("*.ogg,*.mp3,*.wav ; 音频（OGG / MP3 / WAV）", "*.ogg ; OGG / Vorbis 音频", "*.mp3 ; MP3 音频", "*.wav ; WAV 音频")
use_native_dialog = true

