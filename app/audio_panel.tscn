[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://app/AudioPanel.cs" id="1"]
[ext_resource type="PackedScene" path="res://app/score_sync_panel.tscn" id="2_sync"]

[node name="AudioPanel" type="VBoxContainer"]
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Header" type="Button" parent="."]
layout_mode = 2
text = "时间与同步"
toggle_mode = true
button_pressed = false
alignment = 0
theme_type_variation = &"SectionHeader"
custom_minimum_size = Vector2(0, 34)
flat = false

[node name="Fields" type="MarginContainer" parent="."]
visible = false
layout_mode = 2
theme_type_variation = &"SectionFields"

[node name="Content" type="VBoxContainer" parent="Fields"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Enabled" type="CheckButton" parent="Fields/Content"]
layout_mode = 2
text = "预览播放并导出音频"
button_pressed = false
custom_minimum_size = Vector2(0, 32)

[node name="Offset" type="HBoxContainer" parent="Fields/Content"]
layout_mode = 2

[node name="Label" type="Label" parent="Fields/Content/Offset"]
layout_mode = 2
size_flags_horizontal = 3
text = "音频偏移（秒）"

[node name="Value" type="SpinBox" parent="Fields/Content/Offset"]
layout_mode = 2
custom_minimum_size = Vector2(86, 32)
min_value = -3600.0
max_value = 3600.0
step = 0.001
alignment = 2
select_all_on_focus = true

[node name="Help" type="Label" parent="Fields/Content"]
layout_mode = 2
autowrap_mode = 3
text = "正值延后；负值跳过音频开头。"
theme_type_variation = &"HelpLabel"

[node name="ScoreSyncPanel" parent="Fields/Content" instance=ExtResource("2_sync")]
layout_mode = 2

