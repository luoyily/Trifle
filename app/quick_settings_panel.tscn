clip_text = true
text_overrun_behavior = 3
custom_minimum_size = Vector2(30, 0)

[node name="Load" type="Button" parent="Background/Image"]
layout_mode = 2
text = "选择…"
theme_type_variation = &"QuietButton"
tooltip_text = "选择或替换背景图片"

[node name="Clear" type="Button" parent="Background/Image"]
layout_mode = 2
text = "×"
theme_type_variation = &"QuietButton"
custom_minimum_size = Vector2(28, 32)
