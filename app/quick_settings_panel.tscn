text_overrun_behavior = 3
custom_minimum_size = Vector2(40, 0)

[node name="Load" type="Button" parent="Audio"]
layout_mode = 2
text = "选择…"
theme_type_variation = &"QuietButton"
tooltip_text = "选择或替换音频文件"

[node name="Clear" type="Button" parent="Audio"]
layout_mode = 2
