theme_type_variation = &"QuietButton"
custom_minimum_size = Vector2(28, 32)
tooltip_text = "移除音频"

[node name="Background" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Background"]
layout_mode = 2
text = "背景"
custom_minimum_size = Vector2(44, 0)
theme_type_variation = &"MutedLabel"

[node name="Type" type="OptionButton" parent="Background"]
layout_mode = 2
custom_minimum_size = Vector2(78, 32)
fit_to_longest_item = false

[node name="Colors" type="HBoxContainer" parent="Background"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Color" type="ColorPickerButton" parent="Background/Colors"]
layout_mode = 2
custom_minimum_size = Vector2(48, 32)
size_flags_horizontal = 3
edit_alpha = false
tooltip_text = "背景色 / 渐变起点"

[node name="EndColor" type="ColorPickerButton" parent="Background/Colors"]
layout_mode = 2
custom_minimum_size = Vector2(48, 32)
size_flags_horizontal = 3
edit_alpha = false
tooltip_text = "渐变终点"

[node name="Image" type="HBoxContainer" parent="Background"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="File" type="Label" parent="Background/Image"]
layout_mode = 2
text = "未选择图片"
