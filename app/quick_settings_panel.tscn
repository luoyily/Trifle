[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://app/QuickSettingsPanel.cs" id="1"]

[node name="QuickSettingsPanel" type="VBoxContainer"]
script = ExtResource("1")
theme_override_constants/separation = 8

[node name="Midi" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Midi"]
layout_mode = 2
text = "MIDI"
custom_minimum_size = Vector2(44, 0)
theme_type_variation = &"MutedLabel"

[node name="File" type="Label" parent="Midi"]
layout_mode = 2
text = "未选择文件"
size_flags_horizontal = 3
clip_text = true
text_overrun_behavior = 3
custom_minimum_size = Vector2(40, 0)

[node name="Load" type="Button" parent="Midi"]
layout_mode = 2
text = "选择…"
theme_type_variation = &"QuietButton"
tooltip_text = "选择或替换MIDI文件"

[node name="Clear" type="Button" parent="Midi"]
layout_mode = 2
text = "×"
theme_type_variation = &"QuietButton"
custom_minimum_size = Vector2(28, 32)
tooltip_text = "移除 MIDI 和关联音频"

[node name="Audio" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Audio"]
layout_mode = 2
