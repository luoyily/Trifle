theme_type_variation = &"MutedLabel"

[node name="File" type="Label" parent="Score"]
layout_mode = 2
text = "暂不可用"
size_flags_horizontal = 3
theme_type_variation = &"HelpLabel"

[node name="Load" type="Button" parent="Score"]
layout_mode = 2
text = "选择…"
theme_type_variation = &"QuietButton"
disabled = true
tooltip_text = "MuseScore 乐谱支持将在后续版本加入"

[node name="AudioFiles" type="FileDialog" parent="."]
layout_mode = 2
title = "选择外部音频"
size = Vector2i(800, 500)
file_mode = 0
access = 2
use_native_dialog = true
filters = PackedStringArray("*.ogg,*.mp3,*.wav ; 音频（OGG / MP3 / WAV）")

[node name="ImageFiles" type="FileDialog" parent="."]
layout_mode = 2
title = "选择背景图片"
size = Vector2i(800, 500)
file_mode = 0
access = 2
use_native_dialog = true
filters = PackedStringArray("*.png,*.jpg,*.jpeg,*.webp ; 图片文件")
