custom_minimum_size = Vector2(86, 32)
min_value = 0
max_value = 8
step = 0.1
value = 0
alignment = 2
select_all_on_focus = true

[node name="Help" type="Label" parent="Fields/Content/Keyboard/Fields/Content"]
layout_mode = 2
autowrap_mode = 3
text = "作用于整个按下的键面。关闭发光后，仍保留按下状态的颜色。"
