text = "▸ 灯光"
toggle_mode = true
alignment = 0
tooltip_text = "展开 / 折叠灯光设置"
theme_type_variation = &"SubsectionHeader"
custom_minimum_size = Vector2(0, 34)
flat = false

[node name="Fields" type="MarginContainer" parent="."]
visible = false
layout_mode = 2
theme_type_variation = &"SectionFields"

[node name="Content" type="VBoxContainer" parent="Fields"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Keyboard" parent="Fields/Content" instance=ExtResource("2")]
