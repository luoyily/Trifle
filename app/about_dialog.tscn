[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://app/AboutDialog.cs" id="1"]

[node name="AboutDialog" type="Window"]
title = "关于 Trifle"
size = Vector2i(560, 360)
min_size = Vector2i(480, 320)
visible = false
exclusive = true
script = ExtResource("1")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Name" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"PanelTitle"
text = "Trifle"

[node name="Version" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="GitHub" type="RichTextLabel" parent="Margin/Content"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "GitHub：[url=https://github.com/luoyily/Trifle]github.com/luoyily/Trifle[/url]"

[node name="Sep" type="HSeparator" parent="Margin/Content"]
layout_mode = 2

[node name="ComponentsHeader" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "第三方组件"

[node name="Components" type="Label" parent="Margin/Content"]
layout_mode = 2
autowrap_mode = 3
text = "Godot Engine 4.7.2 · MIT License
Melanchall.DryWetMIDI 8.0.3 · MIT License
.NET Runtime 8.0 · MIT License"

[node name="FfmpegNote" type="Label" parent="Margin/Content"]
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"HelpLabel"
text = "视频导出依赖外部 FFmpeg（未随应用分发）。"
